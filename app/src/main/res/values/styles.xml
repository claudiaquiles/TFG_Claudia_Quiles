<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- square button base -->
    <style name="SquareMaterialButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textAllCaps">false</item>

        <!-- background -->
        <item name="backgroundTint">@color/fondoboton</item>

        <!-- border -->
        <item name="strokeColor">@color/borde</item>
        <item name="strokeWidth">4dp</item>

        <!-- round corner -->
        <item name="cornerRadius">15dp</item>
    </style>

    <!-- pause/replay-->
    <style name="SquareMaterialButton.Pause" parent="SquareMaterialButton">
        <item name="backgroundTint">@color/fondopause</item>
        <item name="strokeColor">@color/bordepause</item>
        <item name="rippleColor">@color/letrapause</item>
    </style>

</resources>
